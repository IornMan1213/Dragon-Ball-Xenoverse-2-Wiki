{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Dragon Ball Xenoverse 2 Super Soul Record",
  "type":"object",
  "required":["id","name","verification_status","sources"],
  "properties":{
    "id":{"type":"string","pattern":"^super-soul-[a-z0-9-]+$"},
    "name":{"type":"string","minLength":1},
    "character_association":{"type":"string"},
    "acquisition_methods":{"type":"array","items":{"type":"string"}},
    "pq_sources":{"type":"array","items":{"type":"integer","minimum":1,"maximum":999}},
    "expert_mission_sources":{"type":"array","items":{"type":"integer","minimum":1}},
    "raid_sources":{"type":"array","items":{"type":"string"}},
    "shop_sources":{"type":"array","items":{"type":"string"}},
    "story_sources":{"type":"array","items":{"type":"string"}},
    "effect_summary":{"type":"string"},
    "activation_condition":{"type":"string"},
    "duration":{"type":"string"},
    "magnitude":{"type":"string"},
    "limit_burst":{"type":"string"},
    "ki_effect":{"type":"string"},
    "stamina_effect":{"type":"string"},
    "health_effect":{"type":"string"},
    "damage_effect":{"type":"string"},
    "defense_effect":{"type":"string"},
    "movement_effect":{"type":"string"},
    "transformation_synergy":{"type":"array","items":{"type":"string"}},
    "skill_synergy":{"type":"array","items":{"type":"string"}},
    "pve_notes":{"type":"string"},
    "pvp_notes":{"type":"string"},
    "dlc_requirement":{"type":"string"},
    "verification_status":{"type":"string","enum":["indexed","partially_verified","verified"]},
    "source_conflicts":{"type":"array","items":{"type":"string"}},
    "sources":{"type":"array","minItems":1,"items":{"type":"string","format":"uri-reference"}},
    "last_verified":{"type":"string"}
  },
  "additionalProperties":false
}