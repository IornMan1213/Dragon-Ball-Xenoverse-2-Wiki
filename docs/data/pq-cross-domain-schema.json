{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dragon Ball Xenoverse 2 PQ Cross-Domain Relationship",
  "type": "object",
  "required": ["pq","relationship","target","status","source"],
  "properties": {
    "pq": {"type":"string","pattern":"^pq-[0-9]{3}$"},
    "relationship": {"enum":["pq_rewards_skill","pq_rewards_super_soul","pq_rewards_equipment","pq_features_character","pq_requires_dlc","pq_farming_route"]},
    "target": {"type":"string","minLength":1},
    "status": {"enum":["indexed","source_backed","partially_verified","verified","conflict"]},
    "source": {"type":"string","format":"uri"},
    "notes": {"type":"string"}
  },
  "additionalProperties": false
}
