{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dragon Ball Xenoverse 2 QQ Bang record",
  "type": "object",
  "required": ["id", "verification_status", "sources"],
  "properties": {
    "id": {"type":"string"},
    "name": {"type":"string"},
    "level": {"type":["integer","null"],"minimum":1,"maximum":6},
    "stats": {"type":"object","additionalProperties":{"type":"integer","minimum":-5,"maximum":5}},
    "recipe": {"type":"array","items":{"type":"string"}},
    "mixing_materials": {"type":"array","items":{"type":"string"}},
    "mixing_capsule": {"type":["string","null"]},
    "clothing_inputs": {"type":"array","items":{"type":"string"}},
    "drop_or_shop_source": {"type":"array","items":{"type":"string"}},
    "verification_status": {"enum":["indexed","partially_verified","verified"]},
    "sources": {"type":"array","items":{"type":"string","format":"uri"}},
    "last_verified": {"type":["string","null"]}
  }
}
