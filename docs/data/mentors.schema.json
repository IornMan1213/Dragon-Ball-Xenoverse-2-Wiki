{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dragon Ball Xenoverse 2 Mentor record",
  "type": "object",
  "required": ["id", "name", "verification_status", "sources"],
  "properties": {
    "id": {"type": "string"},
    "name": {"type": "string"},
    "availability": {"type": ["string", "null"]},
    "location": {"type": ["string", "null"]},
    "dlc_requirement": {"type": ["string", "null"]},
    "unlock_requirements": {"type": "array", "items": {"type": "string"}},
    "lessons": {"type": "array", "items": {"type": "string"}},
    "skills": {"type": "array", "items": {"type": "string"}},
    "dual_ultimate": {"type": ["string", "null"]},
    "friendship_notes": {"type": ["string", "null"]},
    "gifts": {"type": "array", "items": {"type": "string"}},
    "verification_status": {"enum": ["indexed", "partially_verified", "verified"]},
    "sources": {"type": "array", "items": {"type": "string", "format": "uri"}},
    "last_verified": {"type": ["string", "null"]}
  }
}
