{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dragon Ball Xenoverse 2 Super Soul record",
  "type": "object",
  "required": ["id", "name", "verification_status", "sources"],
  "properties": {
    "id": {"type":"string"},
    "name": {"type":"string"},
    "rarity": {"type":["integer","null"],"minimum":1,"maximum":5},
    "character_source": {"type":["string","null"]},
    "effects": {"type":"array","items":{"type":"string"}},
    "activation_conditions": {"type":"array","items":{"type":"string"}},
    "limit_burst": {"type":["string","null"]},
    "acquisition": {"type":"array","items":{"type":"string"}},
    "dlc_requirement": {"type":["string","null"]},
    "verification_status": {"enum":["indexed","partially_verified","verified"]},
    "sources": {"type":"array","items":{"type":"string","format":"uri"}},
    "last_verified": {"type":["string","null"]}
  }
}
