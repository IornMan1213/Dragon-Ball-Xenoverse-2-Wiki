{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Dragon Ball Xenoverse 2 Canonical DLC Identity Layer",
  "type":"object",
  "required":["schema_version","game","status","source_of_truth","records","rules"],
  "properties":{
    "schema_version":{"type":"string"},
    "game":{"const":"Dragon Ball Xenoverse 2"},
    "status":{"const":"canonical_identity_layer"},
    "source_of_truth":{"const":"docs/data/pq-reward-relationships.json"},
    "official_baseline":{"type":"string"},
    "verification_policy":{"type":"string"},
    "records":{
      "type":"array","minItems":20,
      "items":{"type":"object","required":["id","name","dlc_requirement","series_or_set","release_unit","verification_status","pq_relationships_source","sources","notes"],
        "properties":{
          "id":{"type":"string","pattern":"^[a-z0-9-]+$"},
          "name":{"type":"string","minLength":1},
          "dlc_requirement":{"type":"string","minLength":1},
          "series_or_set":{"type":"string","minLength":1},
          "release_unit":{"enum":["pack","chapter"]},
          "number":{"type":["integer","null"]},
          "verification_status":{"enum":["indexed","partially_verified","verified"]},
          "pq_relationships_source":{"const":"docs/data/pq-reward-relationships.json"},
          "sources":{"type":"array","items":{"type":"string","format":"uri"},"minItems":1},
          "notes":{"type":"string"}
        }
      }
    },
    "rules":{"type":"array","items":{"type":"string"}}
  }
}

