{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Dragon Ball Xenoverse 2 DLC Index",
  "type":"object",
  "required":["id","title","verification_status","provenance"],
  "properties":{
    "id":{"type":"string"},
    "title":{"type":"string"},
    "status":{"type":"string"},
    "verification_status":{"enum":["indexed","partially_verified","verified"]},
    "chapters":{"type":"array"},
    "provenance":{"type":"array","items":{"type":"string","format":"uri"}},
    "notes":{"type":"string"}
  }
}
