{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dragon Ball Xenoverse 2 Parallel Quest record",
  "type": "object",
  "required": ["id", "name", "verification_status", "sources"],
  "properties": {
    "id": {"type": "string"},
    "number": {"type": ["integer", "null"]},
    "name": {"type": "string"},
    "difficulty": {"type": ["integer", "null"], "minimum": 1, "maximum": 7},
    "dlc_requirement": {"type": ["string", "null"]},
    "unlock_method": {"type": ["string", "null"]},
    "objectives": {"type": "array", "items": {"type": "string"}},
    "ultimate_finish": {"type": "array", "items": {"type": "string"}},
    "enemies": {"type": "array", "items": {"type": "string"}},
    "rewards": {"type": "array", "items": {"type": "string"}},
    "skill_rewards": {"type": "array", "items": {"type": "string"}},
    "equipment_rewards": {"type": "array", "items": {"type": "string"}},
    "super_soul_rewards": {"type": "array", "items": {"type": "string"}},
    "dragon_ball_farming": {"type": "boolean"},
    "verification_status": {"enum": ["indexed", "partially_verified", "verified"]},
    "sources": {"type": "array", "items": {"type": "string", "format": "uri"}},
    "last_verified": {"type": ["string", "null"]}
  }
}
