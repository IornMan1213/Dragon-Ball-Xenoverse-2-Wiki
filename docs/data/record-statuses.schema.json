{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Xenoverse 2 Wiki Record Status",
  "type":"object",
  "required":["verification_status","sources"],
  "properties":{
    "verification_status":{"type":"string","enum":["indexed","partially_verified","verified","conflict"]},
    "sources":{"type":"array","items":{"type":"string","minLength":1},"minItems":1},
    "last_verified":{"type":"string"},
    "source_conflicts":{"type":"array","items":{"type":"object","required":["field","claims","status"],"properties":{"field":{"type":"string"},"claims":{"type":"array","items":{"type":"object","required":["source","value"],"properties":{"source":{"type":"string"},"value":{}}}},"status":{"type":"string","enum":["unresolved","resolved"]}}}},
    "cross_references":{"type":"array","items":{"type":"object","required":["domain","id"],"properties":{"domain":{"type":"string"},"id":{"type":"string"}}}}
  }
}
