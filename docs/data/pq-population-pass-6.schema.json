{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Xenoverse 2 PQ Population Pass",
  "type": "object",
  "required": ["schema_version", "game", "status", "records"],
  "properties": {
    "schema_version": {"type": "string"},
    "game": {"const": "Dragon Ball Xenoverse 2"},
    "status": {"enum": ["indexed_record_population", "partially_verified", "verified"]},
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "number", "name", "difficulty", "objectives", "ultimate_finish", "enemies", "rewards", "verification_status", "sources"],
        "properties": {
          "id": {"type": "string"},
          "number": {"type": "integer", "minimum": 1},
          "name": {"type": "string"},
          "difficulty": {"type": ["integer", "null"], "minimum": 1, "maximum": 7},
          "dlc_requirement": {"type": ["string", "null"]},
          "unlock_method": {"type": ["string", "null"]},
          "objectives": {"type": "array"},
          "ultimate_finish": {"type": ["string", "null"]},
          "enemies": {"type": "array"},
          "rewards": {"type": "array"},
          "skill_rewards": {"type": "array"},
          "equipment_rewards": {"type": "array"},
          "super_soul_rewards": {"type": "array"},
          "dragon_ball_farming": {"type": ["boolean", "null"]},
          "verification_status": {"enum": ["indexed", "partially_verified", "verified"]},
          "sources": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "last_verified": {"type": ["string", "null"]}
        }
      }
    }
  }
}
