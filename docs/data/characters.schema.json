{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://IornMan1213.github.io/Dragon-Ball-Xenoverse-2-Wiki/data/characters.schema.json",
  "title": "Dragon Ball Xenoverse 2 Character Record",
  "type": "object",
  "required": ["id", "name", "verification_status", "sources"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "race": {"type": ["string", "null"]},
    "playable": {"type": ["boolean", "null"]},
    "preset": {"type": ["string", "null"]},
    "form": {"type": ["string", "null"]},
    "unlock_method": {"type": ["string", "null"]},
    "dlc_requirement": {"type": ["string", "null"]},
    "skills": {"type": "array", "items": {"type": "string"}},
    "awoken": {"type": ["string", "null"]},
    "partner_customization": {"type": ["boolean", "null"]},
    "verification_status": {"enum": ["indexed", "partially_verified", "verified"]},
    "sources": {"type": "array", "minItems": 1, "items": {"type": "string", "format": "uri"}},
    "last_verified": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
